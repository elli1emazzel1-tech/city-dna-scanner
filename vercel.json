{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "CityScan MVP",
  "env": {
    "CITYSCAN_CLOUD_GATE_PCT": "20",
    "CITYSCAN_MAX_CITIES_PER_RUN": "5"
  },
  "crons": [
    {
      "path": "/api/cityscan/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cityscan/cron?city=london",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/cityscan/cron?city=paris",
      "schedule": "0 6 12 * *"
    },
    {
      "path": "/api/cityscan/cron?city=amsterdam",
      "schedule": "0 6 18 * *"
    },
    {
      "path": "/api/cityscan/cron?city=berlin",
      "schedule": "0 6 20 * *"
    },
    {
      "path": "/api/cityscan/cron?city=tokyo",
      "schedule": "0 6 22 * *"
    }
  ]
}